{
  "name": "@leiwang2000/dsh-tweaks",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "description": "Tweaks that improve the DeepSeek Harness (DSH) experience",
  "author": "leiwang <leiwang2000@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/l246804/dsh-tweaks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/dsh-tweaks.git"
  },
  "bugs": "https://github.com/l246804/dsh-tweaks/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tweaks"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./client": "./dist/client.js"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "check:artifact": "node scripts/check-artifact.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run && pnpm run check:artifact",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills experimental_sync -y -a universal"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-alpha.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-api-workspace-files": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-attachment": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-dockkit": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-util-workspace-path": "catalog:",
    "@types/node": "catalog:types",
    "@types/react": "catalog:",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "react": "catalog:",
    "simple-git-hooks": "catalog:cli",
    "skills": "catalog:agentic",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "skills": [
    {
      "source": "mattpocock/skills/skills/engineering"
    },
    {
      "source": "mattpocock/skills/skills/productivity"
    },
    {
      "source": "antfu/skills",
      "skills": [
        "antfu"
      ]
    },
    {
      "source": "anthropics/skills/skills/frontend-design"
    },
    {
      "source": "ericlitman/open-pstack/plugins/pstack/skills",
      "skills": [
        "unslop"
      ]
    }
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  }
}
